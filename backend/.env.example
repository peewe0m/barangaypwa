PORT=8001
FRONTEND_URL=http://localhost:3000

# Prefer mongodb+srv when DNS SRV lookups work.
MONGO_URL=mongodb+srv://<user>:<password>@<cluster>/
# If you get querySrv ECONNREFUSED, use Atlas' non-SRV seed-list URI instead:
# MONGO_URL=mongodb://<user>:<password>@<cluster>-shard-00-00.<id>.mongodb.net:27017,<cluster>-shard-00-01.<id>.mongodb.net:27017,<cluster>-shard-00-02.<id>.mongodb.net:27017/<db>?ssl=true&authSource=admin&retryWrites=true&w=majority
DB_NAME=barangay_db
# Production must be a long random value, 32+ chars.
JWT_SECRET=JWT_SECRET=5303cd73db52b24967a064cd20e3563c148c26681bf8a1e1456eaec9b06050b80a107c463803868bc8bc0d14e1c5baf0


ADMIN_EMAIL=admin@barangay.gov.ph
# Development may use admin123. Production must set a strong password, 12+ chars.
ADMIN_PASSWORD=replace-with-strong-admin-password

# Use the project API URL. If you paste a Supabase Storage endpoint like
# https://<project-ref>.storage.supabase.co/storage/v1/s3, the backend will
# normalize it to https://<project-ref>.supabase.co for supabase-js.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Required for backend private storage uploads. Find it in Supabase Dashboard:
# Project Settings > API > Project API keys > service_role.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_BUCKET=barangay-assets
